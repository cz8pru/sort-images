[Unit]
Description=Sort Images Service
Requires=mnt-photo.mount
After=local-fs.target network-online.target mnt-photo.mount
Wants=network-online.target

[Service]
Type=oneshot
User=paja
Group=paja
WorkingDirectory=/home/paja/git/sort-images
ExecStartPre=/usr/bin/sleep 10
ExecStart=/usr/bin/nice -n 19 /usr/bin/python3 /home/paja/git/sort-images/sort_images.py --eadir-remove /home/paja/0_NAS_photo/backaup_pavel_telefon/ /home/paja/0_NAS_photo/
ExecStart=/usr/bin/nice -n 19 /usr/bin/python3 /home/paja/git/sort-images/sort_images.py --eadir-remove /home/paja/0_NAS_photo/backup_alca_telefon/ /home/paja/0_NAS_photo/
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
